# ==============================================================================
# DROVA Express Algeria — Environment Configuration (.env.example)
# ==============================================================================
# IMPORTANT SECURITY RULES:
# 1. Never commit your real '.env' file or real API keys to Git.
# 2. Server-side credentials below MUST NOT have the 'VITE_' prefix to prevent
#    them from ever being bundled into client-side JavaScript.
# ==============================================================================

# --- Server-side Secret Credentials (Backend / Cloud Run / Secret Manager) ---
# Google Places API (New) key for real Algerian merchant discovery
GOOGLE_PLACES_API_KEY="AIzaSyYourSecretGooglePlacesKeyHere"

# Meta Graph API Access Token for Meta Ad Library queries (Algeria / DZ)
META_ACCESS_TOKEN="EAAYourSecretMetaAdLibraryAccessTokenHere"

# Gemini API Key (Server-side privileged AI ops)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Public production URL
APP_URL="https://crm.drova.dz"

# --- Firebase Client Configuration (Safe for frontend bundle) ---
VITE_FIREBASE_API_KEY="AIzaSyDfzBl7A2wGuCV7qdyYunRFKF4Sxud7bTo"
VITE_FIREBASE_AUTH_DOMAIN="drova-express.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="drova-express"
VITE_FIREBASE_STORAGE_BUCKET="drova-express.firebasestorage.app"
