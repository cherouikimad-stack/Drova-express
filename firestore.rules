rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'aj9amW4NKRR6gS3G4MgyG3fU2sS2' ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'cherouikimad@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'super_admin'])
      );
    }

    function isCommercial() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['COMMERCIAL', 'commercial', 'COMMERCIAL_MANAGER', 'commercial_manager'])
      );
    }

    // --- Username-to-Email Mapping for frictionless login ---
    match /usernames/{username} {
      // Allow read so login screen can resolve username -> email before authentication
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // --- User Accounts Collection ---
    match /users/{userId} {
      // All authenticated team members can read users for assignments and audit records
      allow read: if isAuthenticated();
      
      // Super Admin can create/manage any user.
      // Newly authenticated users can initialize their own profile if not existing.
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId && request.resource.data.role != 'SUPER_ADMIN')
      );

      // Super Admin can update any user; users can update their own profile EXCEPT role and status
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.status == resource.data.status)
      );

      // Only Super Admin can delete users
      allow delete: if isSuperAdmin();
    }

    // --- Central Merchants Collection (Master Merchant Database) ---
    match /merchants/{merchantId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // --- Atomic Phone Uniqueness Lock (Duplicate Prevention) ---
    match /merchant_phones/{phoneKey} {
      allow read, write: if isAuthenticated();
    }

    // --- Prospects Collection (Multi-PC Synchronized Pipeline) ---
    match /prospects/{prospectId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // --- CRM Calls Records ---
    match /calls/{callId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // --- Follow-ups ---
    match /followUps/{followUpId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }
    match /followups/{followUpId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // --- Lead Assignments ---
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // --- Merchant Activities & Logs ---
    match /merchantActivities/{activityId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // --- Expéditeurs (Active Shippers) ---
    match /expediteurs/{expediteurId} {
      allow read, write: if isAuthenticated();
    }

    // --- Field Commercial Feedback to Marketing ---
    match /commercialFeedbacks/{feedbackId} {
      allow read, write: if isAuthenticated();
    }

    // --- Notifications ---
    match /notifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // --- Immutable Audit Logs ---
    match /auditLogs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; // Strict immutability
    }

    // --- System Settings ---
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // --- Connection test probe ---
    match /test/{testId} {
      allow read, write: if isAuthenticated();
    }
  }
}
